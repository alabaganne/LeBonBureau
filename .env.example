# Copier en .env.local et remplir. Le backend Medusa a son propre fichier : backend/.env

# Adresse publique de Medusa (appelée par le navigateur).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Clé publique affichée à la fin de `npm run backend:seed` (ou dans l'admin : Paramètres → Clés API publiables).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...
# Optionnel : adresse interne de Medusa pour le rendu serveur (ex. http://medusa:9000 dans Docker).
MEDUSA_BACKEND_URL=

# Adresse publique de la boutique (sitemap, liens de partage).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Suivi (optionnel). Laisser vide pour désactiver.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
