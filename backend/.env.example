# Copier en .env pour le dev local. Base de données : voir DATABASE.md.
# Postgres.app écoute sur 5432 par défaut (5434 sur le Mac principal du projet).
DATABASE_URL=postgres://postgres@127.0.0.1:5432/lebonbureau
# Laisser vide en local ; obligatoire en production.
REDIS_URL=
MEDUSA_BACKEND_URL=http://localhost:9000

STORE_CORS=http://localhost:3000,http://localhost:3001
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:9000,http://localhost:5173,http://localhost:3000,http://localhost:3001

JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Meta Conversions API (optionnel). Sans ces deux valeurs, rien n'est envoyé.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Code de test du Gestionnaire d'événements Meta (optionnel, pour vérifier les envois).
META_TEST_EVENT_CODE=
# Adresse publique de la boutique, envoyée à Meta avec chaque achat.
STOREFRONT_URL=http://localhost:3000
