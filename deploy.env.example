# Sur le VPS : copier en .env (à côté de docker-compose.yml) et remplir.

# Domaines (les DNS doivent pointer vers le VPS).
DOMAIN=lebonbureau.tn
API_DOMAIN=api.lebonbureau.tn

# Secrets : générer chacun avec `openssl rand -hex 32`.
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=

# Affichée par le seed (étape 5 de DEPLOY.md). Relancer le build de la boutique après l'avoir remplie.
MEDUSA_PUBLISHABLE_KEY=

# Meta : ID du pixel + jeton Conversions API (Gestionnaire d'événements → Paramètres).
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optionnel : code de test du Gestionnaire d'événements, à vider une fois vérifié.
META_TEST_EVENT_CODE=

# Optionnel : Google Analytics 4 (G-XXXXXXX) pour voir d'où vient le trafic.
GA_ID=
